# Example environment variables - DO NOT COMMIT REAL KEYS
# Put your real credentials in a local .env file (not committed)

# AI provider (if using a cloud provider)
AI_PROVIDER=none
AI_PROVIDER_KEY=

# Online speech provider key (optional)
ONLINE_SPEECH_KEY=

# Preferred language (en, hi, ne, as)
PREFERRED_LANGUAGE=en

# Path to local SQLite DB (optional)
DATABASE_PATH=anis_ai.db
